DB_PORT=5432

# Notifications - fill in to enable each channel
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# IMPORTANT: Do NOT use your regular Gmail password.
# You MUST generate an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Generate one for "Mail" on "Windows Computer"
#   5. Copy the 16-char password (no spaces) into SMTP_PASS below
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=

# Flask - generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=